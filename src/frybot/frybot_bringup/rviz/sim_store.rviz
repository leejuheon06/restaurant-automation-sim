Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Splitter Ratio: 0.6
    Tree Height: 400
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Alpha: 0.35
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
    - Class: rviz_default_plugins/MarkerArray
      Name: Store (static)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /frybot/markers_static
    - Class: rviz_default_plugins/MarkerArray
      Name: Store (live)
      Enabled: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /frybot/markers
    - Class: rviz_default_plugins/RobotModel
      Name: pinky1
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky1/robot_description
      TF Prefix: pinky1
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: pinky2
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky2/robot_description
      TF Prefix: pinky2
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: pinky3
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky3/robot_description
      TF Prefix: pinky3
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: pinky1_arm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky1/arm/robot_description
      TF Prefix: pinky1_arm
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: pinky2_arm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky2/arm/robot_description
      TF Prefix: pinky2_arm
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: pinky3_arm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky3/arm/robot_description
      TF Prefix: pinky3_arm
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: cook_arm_a
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cook_arm_a/robot_description
      TF Prefix: cook_arm_a
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Name: cook_arm_b
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cook_arm_b/robot_description
      TF Prefix: cook_arm_b
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 238; 238; 236
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 2.6
      Focal Point:
        X: 1.05
        Y: 0.5
        Z: 0
      Pitch: 0.95
      Yaw: -1.5708
      Near Clip Distance: 0.01
      Target Frame: map
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 900
  Width: 1500
