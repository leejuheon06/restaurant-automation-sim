# [수정 2026-11-19] T-40: 전역 코스트맵 표시(Global costmap)를 기본으로 껐다가
# 같은 날 다시 켬(사용자 결정). 실기기 비교(C6-C, 켬·끔 각 3회)에서 끊김과
# 로봇 CPU 에 뚜렷한 차이가 없었음
Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Map
    Name: Measured map
    Enabled: true
    Value: true
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /pinky1/map
    Color Scheme: map
    Alpha: 1.0
    Draw Behind: true
    Use Timestamp: false
  - Class: rviz_common/Group
    Name: pinky1
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky1/global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.2
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_rviz/pinky1/local_costmap
      Color Scheme: costmap
      Alpha: 0.55
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_rviz/pinky1/footprint
      Color: 13; 166; 89
      Alpha: 1.0
    - Class: rviz_default_plugins/RobotModel
      Name: Pinky Pro model
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky1/robot_description
      TF Prefix: pinky1
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
  - Class: rviz_common/Group
    Name: pinky2
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Map
      Name: Global costmap
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky2/global_costmap/costmap
      Color Scheme: costmap
      Alpha: 0.2
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: Local costmap
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_rviz/pinky2/local_costmap
      Color Scheme: costmap
      Alpha: 0.55
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Value: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /fleet_rviz/pinky2/footprint
      Color: 230; 89; 33
      Alpha: 1.0
    - Class: rviz_default_plugins/RobotModel
      Name: Pinky Pro model
      Enabled: true
      Value: true
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pinky2/robot_description
      TF Prefix: pinky2
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
  - Class: rviz_default_plugins/MarkerArray
    Name: Robot names
    Enabled: true
    Value: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet_rviz/robots
  # [수정 2026-11-19] 로드맵(roadmap.json)의 통로·노드와 노드 이름.
  # 이름은 따로 끌 수 있음 (fleet_rviz 노드가 내보냄)
  - Class: rviz_default_plugins/MarkerArray
    Name: Roadmap
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet_rviz/roadmap
  - Class: rviz_default_plugins/MarkerArray
    Name: Roadmap node names
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fleet_rviz/roadmap_names
  Global Options:
    Fixed Frame: map
    Background Color: 235; 237; 240
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Fleet map
      Angle: 0
      Scale: 265
      X: 1.413
      Y: -0.244
Window Geometry:
  Width: 1240
  Height: 800
