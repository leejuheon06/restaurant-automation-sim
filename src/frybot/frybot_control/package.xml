<?xml version="1.0"?>
<package format="3">
  <name>frybot_control</name>
  <version>0.1.0</version>
  <description>FryBot main server: Central Control + Task Manager (pluggable scheduler / path planner)</description>
  <maintainer email="oneteam@example.com">OneTeam</maintainer>
  <license>Apache-2.0</license>
  <!-- 실행 의존성. python3-yaml 은 지도 설정(yaml) 읽기, python3-pil 은
       관리자 화면 지도 그림(map_catalog.map_display)에 씀.
       scipy 는 배정 후보가 많을 때만 쓰며 선언되어 있지 않음(확인 필요) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>frybot_interfaces</exec_depend>
  <!-- [수정 2026-11-23] 작업 지시 18: ceiling_view·ceiling_locator 가 씀 -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
